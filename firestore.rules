rules_version = '2';

// Firestore rules. Deploy: npx firebase-tools deploy --only firestore:rules
//
// Each user reads and writes only the documents under users/{their uid}.
// Cloud Functions use the Admin SDK, which ignores these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
