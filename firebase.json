{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 5001
    },
    "singleProjectMode": true,
    "firestore": {
      "port": 5002,
      "host": "192.168.1.39"
    },
    "auth": {
      "port": 9099,
      "host": "192.168.1.39"
    },
    "hosting": {
      "port": 5003,
      "host": "192.168.1.39"
    },
    "database": {
      "port": 9000,
      "host": "192.168.1.39"
    }
  },
  "hosting": {
    "public": "public",
    "site": "householdexpenses2",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/callback",
        "function": "handleOAuthCallback"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}